# Generated by setup orchestrator.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="{{ dev.shell.oh_my_zsh.theme }}"
plugins=({% for plugin in dev.shell.oh_my_zsh.plugins %}{{ plugin }} {% endfor %})

source $ZSH/oh-my-zsh.sh

# Useful defaults for terminal UX.
export EDITOR=nano
export LANG={{ common.locale }}

# Better default commands where installed.
alias ll="ls -lah"
alias gs="git status"
