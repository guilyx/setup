# Generated by setup orchestrator.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="{{ dev.shell.oh_my_zsh.theme }}"
plugins=({% for plugin in dev.shell.oh_my_zsh.plugins %}{{ plugin }} {% endfor %}{% for plugin in dev.shell.oh_my_zsh.custom_plugins | default([]) %}{{ plugin.name }} {% endfor %})

source $ZSH/oh-my-zsh.sh

export EDITOR={{ dev.editor.default | default('nano') }}
export VISUAL="$EDITOR"
export LANG={{ common.locale }}
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

# History that survives multiple terminals and does not fill up with noise.
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY INC_APPEND_HISTORY

alias ll="ls -lah"
alias gs="git status"
alias gd="git diff"
alias gl="git log --oneline --graph --decorate -20"
alias ..="cd .."
alias ...="cd ../.."

command -v eza >/dev/null 2>&1 && alias ls="eza --group-directories-first"
command -v bat >/dev/null 2>&1 && alias cat="bat --paging=never"

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"
{% if dev.shell.starship.enabled | default(false) %}
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
{% endif %}
[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[ -f /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh
