# Generated by setup orchestrator. Edit config/defaults.yaml, not this file.
[data]
{% for key, value in (chezmoi.data | default({})).items() %}
{% if value is boolean %}
    {{ key }} = {{ value | lower }}
{% elif value is number %}
    {{ key }} = {{ value }}
{% else %}
    {{ key }} = {{ value | to_json }}
{% endif %}
{% endfor %}

[git]
    autoCommit = false
    autoPush = false
